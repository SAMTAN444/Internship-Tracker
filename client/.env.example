# Base URL of the backend API.
# For local development, point this at your local server:
VITE_API_URL=http://localhost:5005
# If unset, the app falls back to the deployed backend
# (https://internship-tracker-api.onrender.com).

# Firebase web app config (Firebase console > Project settings > Your apps).
# These are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
