# MongoDB connection string (local Docker example shown)
MONGO_URI=mongodb://localhost:27018/trackly

# API port. 5005 avoids clashing with FormSG (which uses 5001).
PORT=5005

# Firebase service account key, base64-encoded on one line. Generate it in
# Firebase console > Project settings > Service accounts, then:
#   base64 -i <key>.json | tr -d '\n'
# Never commit the key or this value.
FIREBASE_SERVICE_ACCOUNT_BASE64=
